[Unit]
Description=Nyra Router
After=network-online.target
Wants=network-online.target
[Service]
Type=simple
User=root
WorkingDirectory=/opt/nyra-router
EnvironmentFile=-/opt/nyra-router/.env
ExecStart=/opt/nyra-router/.venv/bin/uvicorn router.app:app --host 0.0.0.0 --port 8090
Restart=on-failure
RestartSec=2
[Install]
WantedBy=multi-user.target
