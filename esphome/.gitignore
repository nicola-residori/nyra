# Private installation-specific speaker instances.
# The public repository keeps only reusable packages, examples, tooling, and docs.

# Generated top-level Device Builder entrypoints, e.g. nyra-mansarda.yaml.
/nyra-*.yaml

# Generated real device definitions, e.g. devices/nyra-mansarda.yaml.
/devices/nyra-*.yaml

# Keep the public example tracked.
!/devices/nyra-speaker.example.yaml

# Per-device secrets are always local.
/device_secrets/*.yaml

# Keep documentation for the private secrets directory tracked.
!/device_secrets/README.md
